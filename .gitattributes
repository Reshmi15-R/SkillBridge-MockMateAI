# Normalize line endings
* text=auto

# Python files
*.py text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf

# JSON / YAML
*.json text
*.yml text
*.yaml text

# Markdown
*.md text

# Environment files
.env text

# Ignore diffs for binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary